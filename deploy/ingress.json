{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "Ingress",
  "metadata": { "name": "backlog-expedition" },
  "spec": {
    "rules": [{
      "host": "bex.example.com",
      "http": { "paths": [{
        "path": "/",
        "pathType": "Prefix",
        "backend": { "service": { "name": "backlog-expedition", "port": { "name": "http" } } }
      }] }
    }]
  }
}
